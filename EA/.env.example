# Copia este archivo a ".env" (o exporta las mismas variables en tu shell/
# PowerShell) y rellena los valores reales. NO subas el ".env" real a git
# (ya esta en .gitignore) ni lo compartas en capturas de pantalla, chats, etc.

# Host donde escucha el puente. Dejar en 127.0.0.1 salvo que sepas
# exactamente por que necesitas otra cosa (ver ASTUR_AI_SETUP.md).
ASTUR_AI_HOST=127.0.0.1
ASTUR_AI_PORT=8765

# Proveedor del modelo local: "ollama" o "openai" (para LM Studio / APIs
# compatibles con OpenAI).
ASTUR_AI_PROVIDER=ollama
ASTUR_AI_MODEL=qwen2.5:7b
# ASTUR_AI_URL=http://127.0.0.1:11434/api/chat   # opcional, override manual

# Token compartido: OBLIGATORIO antes de activar UseLocalAI en el EA. Debe
# coincidir EXACTAMENTE con el input AISharedSecret del .mq4. Generar uno
# nuevo y aleatorio, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
ASTUR_AI_SECRET=coloca_aqui_un_token_largo_y_aleatorio

# Umbral minimo de resultados cerrados antes de que el puente deje que la
# confianza de la IA supere 0.49 (ver README/ASTUR_AI_SETUP.md).
ASTUR_AI_MIN_MEMORY=30

# Cola de archivos para que la gestion (MANAGE) sea asincrona y no bloquee
# el EA (ver "Gestion MANAGE asincrona" en ASTUR_AI_SETUP.md). Debe apuntar
# a la MISMA carpeta MQL4/Files que usa la terminal donde corre el EA:
# en MT4, Archivo > Abrir carpeta de datos > MQL4 > Files. Ejemplos:
#   Windows:  C:\Users\<usuario>\AppData\Roaming\MetaQuotes\Terminal\<hash>\MQL4\Files
#   Wine:     /home/<usuario>/.wine/drive_c/users/<usuario>/AppData/Roaming/MetaQuotes/Terminal/<hash>/MQL4/Files
# Dejar vacio desactiva el vigilante (MANAGE solo funcionara si
# UseAsyncManage=false en el EA, en modo sincrono/bloqueante).
ASTUR_AI_MQL4_FILES_DIR=
# Deben coincidir con AIAsyncRequestFileName / AIAsyncResponseFileName del EA
ASTUR_AI_REQUEST_FILE=ASTUR_AI_ManageRequest.json
ASTUR_AI_RESPONSE_FILE=ASTUR_AI_ManageResponse.txt
ASTUR_AI_WATCH_POLL_SECONDS=1.0
