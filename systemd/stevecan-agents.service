[Unit]
Description=StevecAN agentes de aprendizaje 24/7
After=stevecan-llama.service
Requires=stevecan-llama.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
EnvironmentFile=__ROOT__/.env
ExecStart=__ROOT__/.venv/bin/python -m stevecan
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
