{
  "name": "jarvis-os-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis OS Cloud — serverless AI assistant on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply jarvis --local",
    "db:migrate:remote": "wrangler d1 migrations apply jarvis --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.9",
    "wrangler": "^3.99.0"
  }
}
