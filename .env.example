# Servidor OpenAI-compatible del modelo local (llama-server, Ollama o LM Studio)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf
LLM_API_KEY=none
# Slots paralelos del servidor (= -np de llama-server). 8 agentes -> 8 slots
LLM_PARALLEL=8
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.6
# Ruta al GGUF (solo para scripts/llama-server.sh y docker-compose)
GGUF_PATH=/models/Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf
CTX_PER_SLOT=8192
GPU_LAYERS=99
# Buscador propio SearXNG (opcional, recomendado: sin límites). Con docker compose: http://searxng:8080
SEARXNG_URL=
# Tu código: rutas separadas por ':' que el agente librarian indexa y resume (RAG)
CODE_DIRS=
# Dominios con agente experto dedicado (separados por ';'). Vacío = lista por defecto de config.py
EXPERT_DOMAINS=
# Proyectos que el agente developer mejora (separados por ':'), p. ej. Astur OS y Astur APK
PROJECT_DIRS=
# 1 = developer busca mejoras por su cuenta; 0 = solo por orden tuya (python -m stevecan.developer <ruta> "instrucción")
AUTO_IMPROVE=1
# 1 = fusiona en tu rama las mejoras que pasan los tests; 0 = las deja en ramas stevecan/* para que las revises
AUTO_APPLY=0
BACKUP_KEEP=30
MAX_CHANGE_LINES=400
# API HTTP del sistema unificado (python -m stevecan.serve). Pon un token si el servidor es accesible desde fuera.
API_HOST=0.0.0.0
API_PORT=8765
API_TOKEN=
# Velocidad: modelo borrador para decodificación especulativa (GGUF pequeño: el entrenado por stevecan.train o Qwen3-0.6B-Q8_0)
DRAFT_GGUF=
DRAFT_MAX=16
DRAFT_MIN=4
THREADS=
# Entrenamiento en CPU (LoRA sobre modelo pequeño con el dataset real del sistema). Ver requirements-train.txt
AUTO_TRAIN=0
AUTO_TRAIN_EVERY_HOURS=24
TRAIN_BASE_MODEL=Qwen/Qwen3-0.6B
TRAIN_STEPS=300
TRAIN_MIN_EXAMPLES=200
TRAIN_THREADS=
LLAMA_CPP_DIR=
# Datasets externos propios (jsonl/json/csv/txt/md), separados por ':'
DATASETS=
# Inteligencia
# razonar antes de responder + autocrítica en tareas difíciles
REASONING=1
# 3 = genera 3 candidatos en paralelo y un juez elige (más lento, más acierto)
BEST_OF=1
# opcional: segundo llama-server con Qwen3-30B-A3B-Thinking-2507 para tareas difíciles
LLM_THINK_BASE_URL=
LLM_THINK_MODEL=
# Búsqueda semántica (opcional): scripts/llama-embed.sh con EMBED_GGUF (p. ej. Qwen3-Embedding-0.6B-Q8_0.gguf)
EMBED_GGUF=
EMBED_PORT=8081
# http://127.0.0.1:8081/v1 cuando el servidor de embeddings esté activo
EMBED_BASE_URL=
# Umbrales de calidad (alertas en el panel y en data/alerts.log)
EVAL_MIN_EXAM=0.6
EVAL_MIN_KATA=0.5
EVAL_MAX_DROP=0.15
EVAL_MAX_DELETE_RATE=0.4
EVAL_MAX_ERROR_RATE=0.2
# Datos
DATA_DIR=./data
WORKSPACE_DIR=./data/workspace
# Segundos entre ciclos de cada agente
CYCLE_SECONDS=20
